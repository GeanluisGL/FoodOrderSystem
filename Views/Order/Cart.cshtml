<div class="row g-4">

    <!-- Cart Items -->
    <div class="col-lg-8">
        @foreach (var item in Model)
        {
            <div class="card mb-5 shadow-sm">
                <div class="row g-0 align-items-center">
                    <!-- Image -->
                    <div class="col-md-3">
                        <img src="@item.ImageUrl" class="img-fluid rounded-start" alt="@item.Name" style="height: 100%; min-height: 120px; object-fit: cover;">
                    </div>
                    <!-- Details -->
                    <div class="col-md-9">
                        <div class="card-body d-flex justify-content-between align-items-center py-4">
                            <div>
                                <h5 class="card-title fw-bold mb-4">@item.Name</h5>
                                <p class="card-text text-primary fw-bold mb-0">$@item.Price</p>
                            </div>
                            <div class="d-flex align-items-center gap-4">
                                <!-- Form for Update -->
                                <form action="/Order/UpdateQuantity" method="post" class="d-flex align-items-center gap-4 m-0">
                                    <input type="hidden" name="foodItemId" value="@item.FoodItemId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm text-center" style="width: 60px;" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Update</button>
                                </form>
                                <!-- Delete Button -->
                                <a href="/Order/RemoveFromCart?foodItemId=@item.FoodItemId" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <!-- Order Summary -->
    <div class="col-lg-4">
        <div class="card shadow-sm mt-5 mt-lg-0">
            <div class="card-body p-4">
                <h5 class="card-title fw-bold mb-4">Order Summary</h5>
                <hr class="mb-4" />
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Total:</span>
                    <span class="fw-bold fs-5 text-primary">$@ViewBag.Total</span>
                </div>
                <a href="#" class="btn btn-primary w-100 mt-2">
                    Proceed to Checkout <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
